# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database (SQLite - 嵌入式，零额外进程)
DATABASE_URL=sqlite://data/woohoo.db?mode=rwc

# Security
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRE_HOURS=72

# Assets Storage (本地文件系统)
ASSETS_DIR=./data/assets
UPLOAD_TMP_DIR=./data/uploads-tmp
UPLOAD_SESSION_TTL_SECS=86400

# AI 会话历史策略（会话缓存命中率优化，见 docs/prd/conversation-cache-hit-rate/）
# 截断开关：false 恢复旧行为（每次请求发送全量历史）
AI_CHAT_HISTORY_TRUNCATION_ENABLED=true
# 前缀稳定截断窗口：保留最早 PREFIX_KEEP 条 + 最近 RECENT_KEEP 条，
# 总历史超过二者之和才触发裁剪
AI_CHAT_HISTORY_PREFIX_KEEP=8
AI_CHAT_HISTORY_RECENT_KEEP=40

# Logging
RUST_LOG=woohoo_server=debug,tower_http=debug

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database (SQLite - 嵌入式，零额外进程)
DATABASE_URL=sqlite://data/woohoo.db?mode=rwc

# Security
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRE_HOURS=72

# Assets Storage (本地文件系统)
ASSETS_DIR=./data/assets
UPLOAD_TMP_DIR=./data/uploads-tmp
UPLOAD_SESSION_TTL_SECS=86400

# Logging
RUST_LOG=woohoo_server=debug,tower_http=debug

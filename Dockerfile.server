FROM rust:1.88-bookworm AS builder

WORKDIR /app/server

RUN apt-get update \
  && apt-get install -y --no-install-recommends pkg-config libsqlite3-dev \
  && rm -rf /var/lib/apt/lists/*

COPY server/Cargo.toml server/Cargo.lock ./
COPY server/src ./src
COPY server/migrations ./migrations

RUN cargo build --release

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl libsqlite3-0 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/server/target/release/woohoo-server /usr/local/bin/woohoo-server

ENV HOST=0.0.0.0 \
  PORT=8080 \
  PORT_SEARCH_LIMIT=0 \
  DATABASE_URL=sqlite:///data/woohoo.db?mode=rwc \
  ASSETS_DIR=/data/assets \
  PROJECT_FILES_DIR=/data/project-files \
  RUNTIME_MANIFEST_PATH=/data/runtime/server-info.json \
  RUST_ENV=production \
  RUST_LOG=woohoo_server=info,tower_http=info

VOLUME ["/data"]
EXPOSE 8080

CMD ["woohoo-server"]

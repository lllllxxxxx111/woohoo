{
  "name": "woohoo-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite --host 127.0.0.1 --port 1420",
    "dev:server": "cargo run --manifest-path server/Cargo.toml",
    "dev:all": "node scripts/dev-all.mjs",
    "drill:rollback:local": "node scripts/run-local-rollback-drill.mjs",
    "drill:rollback:cross-version": "node scripts/run-cross-version-rollback-drill.mjs",
    "build": "tsc && vite build",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write src vite.config.ts eslint.config.js package.json tsconfig.json tsconfig.node.json .prettierrc.json",
    "format:check": "prettier --check src vite.config.ts eslint.config.js package.json tsconfig.json tsconfig.node.json .prettierrc.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.12",
    "@fontsource/inter": "^5.2.8",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^1.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}